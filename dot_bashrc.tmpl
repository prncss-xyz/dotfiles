export GRIM_DEFAULT_DIR=$HOME/Media/Pictures/Captures
export PERSONAL=$HOME/Personal
# Environment variables from config.fish
export SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket)
export GPG_TTY=$(tty)
export RIPGREP_CONFIG_PATH=$HOME/.config/rg/config
export HOSTNAME=$(hostname)
export PNPM_HOME=$HOME/.local/share/pnpm
export BUN_INSTALL="$HOME/.bun"
export PATH="$PATH:$PNPM_HOME:$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.luarocks/bin:$BUN_INSTALL"
export PASSWORD_STORE_DIR=$PERSONAL/pass
export DISPLAY=:1
export SUPERMEMORY_API_KEY={{ output "pass" "show" "supermemory.ai/prncss-xyz" | trim }}
