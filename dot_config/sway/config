for_window [class="^.*"] border pixel 1
default_border none
default_floating_border none

set $mod Mod4
set $left semicolon
set $down j
set $up k
set $right l

input type:keyboard {
  xkb_layout ca
  xkb_options caps:escape
}

seat * hide_cursor 10000
output HDMI-A-3 scale 2


bindsym $mod+Shift+q kill

# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button + $mod.
# Despite the name, also works for non-floating windows.
# Change normal to inverse to use left mouse button for resizing and right
# mouse button for dragging.
floating_modifier $mod normal

bindsym $mod+ctrl+c reload
bindsym $mod+ctrl+e exit
bindsym $mod+ctrl+q exec waylock
bindsym $mod+ctrl+r exec sudo /usr/sbin/reboot
bindsym $mod+ctrl+p exec sudo /usr/sbin/poweroff

bindsym $mod+a focus parent
bindsym $mod+space focus mode_toggle
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h scratchpad show
bindsym $mod+n workspace number 1
bindsym $mod+m workspace number 2
bindsym $mod+comma workspace number 3
bindsym $mod+period workspace number 4
bindsym $mod+eacute workspace number 5
bindsym $mod+Shift+h move scratchpad
bindsym $mod+Shift+n move container to workspace number 1
bindsym $mod+Shift+m move container to workspace number 2
bindsym $mod+Shift+comma move container to workspace number 3
bindsym $mod+Shift+period move container to workspace number 4
bindsym $mod+Shift+eacute move container to workspace number 5

bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+z layout stacking
bindsym $mod+x layout tabbed
bindsym $mod+c layout toggle split
bindsym $mod+f fullscreen

mode resize {
  bindsym $left resize shrink width 10px
  bindsym $down resize grow height 10px
  bindsym $up resize shrink height 10px
  bindsym $right resize grow width 10px
  bindsym Left resize shrink width 10px
  bindsym Down resize grow height 10px
  bindsym Up resize shrink height 10px
  bindsym Right resize grow width 10px
  bindsym ctrl+c mode default
  bindsym escape mode default
  bindsym return mode default
}
bindsym $mod+r mode resize

bindsym --locked XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym --locked XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86AudioStop exec --no-startup-id playerctl stop

bindsym --locked XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 4%-
bindsym --locked XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 4%+
bindsym --locked XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

mode audio {
  bindsym space exec --no-startup-id playerctl play-pause; mode default
  bindsym $left exec --no-startup-id playerctl previous; mode default
  bindsym $right exec --no-startup-id playerctl next; mode default
  bindsym x exec --no-startup-id playerctl stop

  bindsym m exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
  bindsym $up exec --no-startup-id wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 4%+ 
  bindsym $down exec --no-startup-id wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 4%-
  bindsym shift+$up exec --no-startup-id wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 12%+
  bindsym shift+$down exec --no-startup-id wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 12%-

  bindsym ctrl+c mode default
  bindsym escape mode default
  bindsym return mode default
}
bindsym $mod+o mode audio

bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
mode lumino {
  bindsym $up exec --no-startup-id brightnessctl -e4 -n2 set 2%+
  bindsym $down exec --no-startup-id brightnessctl set 2%-
  bindsym shift+$up exec --no-startup-id brightnessctl set 100%
  bindsym shift+$down exec --no-startup-id brightnessctl set 0%
  bindsym ctrl+c mode default
  bindsym escape mode default
  bindsym return mode default
}
bindsym $mod+i mode lumino

bindsym Print exec grim
bindsym $mod+s exec grim
bindsym $mod+d exec fuzzel
bindsym $mod+p exec PASSWORD_STORE_DIR=$HOME/Personal/pass/ tessen
bindsym $mod+y exec firefox
bindsym $mod+e exec neovide

# unused
bindsym $mod+u exec echo
bindsym $mod+w exec echo

for_window [app_id=^chromium$] inhibit_idle fullscreen
for_window [app_id=^firefox$] inhibit_idle fullscreen
for_window [app_id=^celluloid$] inhibit_idle fullscreen
for_window [title=^scratchpad$] move scratchpad

exec --no-startup-id swayidle -w \
  timeout 300 'waylock -fork-on-lock' \
  timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
  before-sleep 'waylock -fork-on-lock'
exec /usr/libexec/polkit-gnome-authentication-agent-1
exec kdeconnectd
exec dbus-update-activation-environment XDG_CURRENT_DESKTOP=sway WAYLAND_DISPLAY DISPLAY SWAYSOCK PATH
exec turnstile-update-runit-env XDG_CURRENT_DESKTOP=sway WAYLAND_DISPLAY DISPLAY SWAYSOCK PATH
exec_always sv restart polkit-gnome
exec --no-startup-id .local/bin/random-wallpaper
exec --no-startup-id swaync
bindsym $mod+g exec swaync-client -t
bindsym $mod+Shift+g exec swaync-client -t -sw
exec --no-startup-id wlsunset -S 07:00 -s 16:00
exec --no-startup-id udiskie
exec --no-startup-id waybar

# autostart
exec firefox
include ./foot
include /etc/sway/config.d/*
