{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@tarquinen/opencode-dcp",
    "@mohak34/opencode-notifier",
    "@franlol/opencode-md-table-formatter",
    "@nick-vi/opencode-type-inject",
    "opencode-agent-memory",
    "github:JRedeker/opencode-morph-fast-apply"
    // "oh-my-opencode"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "ast-grep *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git commit *": "allow",
      "git add *": "allow",
      "git push *": "allow",
      "sed *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "fd *": "allow",
      "find *": "allow",
      "cat *": "allow",
      "bat *": "allow",
      "echo *": "allow",
      "type *": "allow",
      "uname *": "allow",
      "xbps-query -l": "allow",
      "pnpm vitest *": "allow",
      "pnpm build": "allow",
      "pnpm run build": "allow",
      "pnpm check:*": "allow",
      "pnpm run check:*": "allow",
      "pnpm lint:*": "allow",
      "pnpm run lint:*": "allow",
      "pnpm verify:*": "allow",
      "pnpm run verify:*": "allow",
      "pnpm fix:*": "allow",
      "pnpm run fix:*": "allow",
    },
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["bun", "x", "@upstash/context7-mcp"],
      "enabled": true,
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
    },
    "talivy": {
      "type": "local",
      "command": ["bun", "x", "tavily-mcp@latest"],
      "enabled": true,
    },
    "exa": {
      "type": "local",
      "command": ["bun", "x", "exa-mcp-server"],
      "enabled": true,
    },
    "codemod": {
      "type": "local",
      "command": ["bun", "x", "codemod@latest", "mcp"],
      "enabled": false,
    },
    "duckduckgo": {
      "type": "local",
      "command": ["uvx", "duckduckgo-mcp-server"],
      "enabled": false,
    },
  },
  "tools": {
    "edit": true,
    "grep": true,
  },
  "instructions": [
    ".opencode/node_modules/opencode-morph-fast-apply/MORPH_INSTRUCTIONS.md",
  ],
}
