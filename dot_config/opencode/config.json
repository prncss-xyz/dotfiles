{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-gemini-auth@latest",
    "@tarquinen/opencode-dcp@latest"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "morph": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "MORPH_API_KEY=$(morphllm.com/quarknoir@gmail.com) pnpm dlx @morphllm/morphmcp"
      ],
      "enabled": false
    },
    "codemod": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "codemod@latest",
        "mcp"
      ],
      "enabled": false
    },
    "duckduckgo": {
      "type": "local",
      "command": [
        "uvx",
        "duckduckgo-mcp-server"
      ],
      "enabled": false
    }
  },
  "tools": {
    "edit": true,
    "grep": true
  }
}
