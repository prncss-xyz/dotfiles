gpg-connect-agent updatestartuptty /bye > /dev/null
set -x SSH_AUTH_SOCK (gpgconf --list-dirs agent-ssh-socket)
set -x GPG_TTY (tty)
set -x RIPGREP_CONFIG_PATH $HOME/.config/rg/config
set -x HOSTNAME (hostname)
set -x NPM_CONFIG_PREFIX $HOME/.local
set -x PNPM_HOME $HOME/.local/share/pnpm
set -x PATH "$PATH:$PNPM_HOME:$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.luarocks/bin"
set -x BUN_INSTALL "$HOME/.bun"
set -x PATH $BUN_INSTALL/bin $PATH

{{ if ne .chezmoi.os "darwin" -}}
set -x GRIM_DEFAULT_DIR $HOME/Media/Pictures/Captures
set -x PERSONAL $HOME/Personal
set -x SUPERMEMORY_API_KEY {{ pass "supermemory.ai/prncss-xyz" }}
set -x MORPH_API_KEY {{ pass "morphllm.com/quarknoir@gmail.com" }}
set -x EXA_API_KEY {{ pass "exa.ai/juliette.lamarche.xyz@gmail.com" }}
set -x TAVILY_API_KEY {{ pass "talivy/prncss-xyz" }}
set -x GROQ_API_KEY {{ pass "groq.com/keys/pi" }}
{{ end -}}
{{ if eq .hosted "true" -}}
set -x HOSTED HOSTED
{{ end -}}
