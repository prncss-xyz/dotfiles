#!/bin/sh

FORCE=0
if [ "$1" = "-f" ] || [ "$1" = "--force" ]; then
    FORCE=1
    shift
fi

TARGET_DIR="${1:-.}"
TARGET_DIR_ABS="$(cd "$TARGET_DIR" 2>/dev/null && pwd)"

if [ -z "$TARGET_DIR_ABS" ]; then
    echo "Error: Directory not found or inaccessible."
    exit 1
fi

if ! git -C "$TARGET_DIR_ABS" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Error: '$TARGET_DIR' is not inside a git repository."
    exit 1
fi

MAIN_GIT="$(git -C "$TARGET_DIR_ABS" rev-parse --path-format=absolute --git-common-dir)"
BRANCH="$(git -C "$TARGET_DIR_ABS" symbolic-ref --short HEAD 2>/dev/null || true)"

if [ $FORCE -eq 0 ]; then
    if [ -n "$BRANCH" ]; then
        printf "Are you sure you want to remove worktree '%s' and branch '%s'? [y/N] " "$TARGET_DIR_ABS" "$BRANCH"
    else
        printf "Are you sure you want to remove worktree '%s'? [y/N] " "$TARGET_DIR_ABS"
    fi
    read -r response
    case "$response" in
        [yY][eE][sS]|[yY])
            ;;
        *)
            echo "Aborted."
            exit 0
            ;;
    esac
fi

# Cd out of the target directory to avoid shell "deleted directory" errors
cd /

echo "Removing worktree at $TARGET_DIR_ABS..."
if [ $FORCE -eq 1 ]; then
    WT_FLAGS="--force"
else
    WT_FLAGS=""
fi

# We use eval or just unquoted WT_FLAGS if empty, but in sh `worktree remove ""` would fail.
# Better to build the command or just use an if statement
if [ $FORCE -eq 1 ]; then
    if ! git --git-dir="$MAIN_GIT" worktree remove --force "$TARGET_DIR_ABS"; then
        echo "Error: Failed to remove worktree."
        exit 1
    fi
else
    if ! git --git-dir="$MAIN_GIT" worktree remove "$TARGET_DIR_ABS"; then
        echo "Error: Failed to remove worktree."
        echo "Hint: Use 'gwtr -f' to force removal."
        exit 1
    fi
fi
echo "Worktree removed successfully."

if [ -n "$BRANCH" ]; then
    echo "Removing local branch '$BRANCH'..."
    BR_FLAGS="-D"

    if git --git-dir="$MAIN_GIT" branch $BR_FLAGS "$BRANCH"; then
        echo "Branch removed successfully."
    else
        echo "Error: Failed to remove branch."
        if [ $FORCE -eq 0 ]; then
            echo "Hint: Use 'gwtr -f' to force removal."
        fi
        exit 1
    fi
fi
