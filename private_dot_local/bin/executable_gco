#!/bin/sh

if [ $# -gt 0 ]; then
    exec git checkout "$@"
fi

current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

if [ -n "$current_branch" ]; then
    branch=$(git branch --all | grep -v "$current_branch" | fzf | tr -d '[:space:]')
else
    branch=$(git branch --all | fzf | tr -d '[:space:]')
fi

if [ -n "$branch" ]; then
    # Remove 'remotes/' prefix if present so git can set up tracking properly
    clean_branch=$(echo "$branch" | sed 's/^remotes\///')
    git checkout "$clean_branch"
fi
