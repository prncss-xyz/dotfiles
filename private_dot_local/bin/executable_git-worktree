#!/bin/sh

artifacts=${ARTIFACTS_DIR:-"$HOME/projects/notes/main/dev/artifacts"}

relative_path() {
	awk -v from="$1" -v to="$2" 'BEGIN {
		from_count = split(from, from_parts, "/")
		to_count = split(to, to_parts, "/")
		common = 1
		while (common <= from_count && common <= to_count && from_parts[common] == to_parts[common])
			common++
		result = ""
		for (index = common; index <= from_count; index++)
			if (from_parts[index] != "") result = result (result == "" ? "" : "/") ".."
		for (index = common; index <= to_count; index++)
			if (to_parts[index] != "") result = result (result == "" ? "" : "/") to_parts[index]
		print result == "" ? "." : result
	}'
}

link_artifacts() {
	repo_root=$1
	repo=$2
	branch=$3
	target=$artifacts/$repo
	branch_dir=$target/$(printf '%s' "$branch" | tr '/' '-')
	link_path=$repo_root/.artifacts

	if ! mkdir -p "$branch_dir"; then
		printf 'warning: failed to create artifacts directory: %s\n' "$branch_dir" >&2
		return
	fi

	[ -e "$link_path" ] || [ -L "$link_path" ] && return
	link_target=$(relative_path "$repo_root" "$target")
	if ! ln -s "$link_target" "$link_path"; then
		printf 'warning: failed to create artifacts link: %s\n' "$link_path" >&2
	fi
}

get_default_file() {
	repo_dir=$1
	preferred_rel=${2:-}

	if [ -n "$preferred_rel" ] && [ -f "$repo_dir/$preferred_rel" ]; then
		printf '%s\n' "$repo_dir/$preferred_rel"
	elif [ -f "$repo_dir/README.md" ]; then
		printf '%s\n' "$repo_dir/README.md"
	else
		first=$(git -C "$repo_dir" ls-files 2>/dev/null | awk 'NR == 1 { print; exit }')
		if [ -n "$first" ]; then
			printf '%s\n' "$repo_dir/$first"
		else
			printf '%s\n' "$repo_dir/README.md"
		fi
	fi
}

branch=${1:-}
if [ -z "$branch" ]; then
	printf 'Branch name: ' >&2
	IFS= read -r branch
fi
[ -n "$branch" ] || exit 0

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
	printf 'error: not in a git repository\n' >&2
	exit 1
}

preferred_rel=
if [ $# -ge 2 ]; then
	case $2 in
		"$repo_root"/*) preferred_rel=${2#"$repo_root"/} ;;
		*) preferred_rel=$2 ;;
	esac
fi

parent=$(dirname "$repo_root")
worktree_path=$parent/$branch

git fetch origin "$branch" >/dev/null 2>&1 || :
if git rev-parse --verify "origin/$branch" >/dev/null 2>&1; then
	set -- git worktree add "$worktree_path" "$branch"
else
	set -- git worktree add "$worktree_path" -b "$branch"
fi

if ! result=$("$@" 2>&1); then
	printf 'error: failed to create worktree: %s\n' "$result" >&2
	exit 1
fi

repo=$(basename "$worktree_path")
[ "$repo" = "$branch" ] && repo=$(basename "$(dirname "$worktree_path")")
link_artifacts "$worktree_path" "$repo" "$branch"
get_default_file "$worktree_path" "$preferred_rel"
