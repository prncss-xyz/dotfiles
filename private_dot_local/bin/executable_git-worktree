#!/bin/sh

get_default_file() {
	repo_dir=$1
	preferred_rel=${2:-}

	if [ -n "$preferred_rel" ] && [ -f "$repo_dir/$preferred_rel" ]; then
		printf '%s\n' "$repo_dir/$preferred_rel"
	elif [ -f "$repo_dir/README.md" ]; then
		printf '%s\n' "$repo_dir/README.md"
	else
		first=$(git -C "$repo_dir" ls-files 2>/dev/null | awk 'NR == 1 { print; exit }')
		if [ -n "$first" ]; then
			printf '%s\n' "$repo_dir/$first"
		else
			printf '%s\n' "$repo_dir/README.md"
		fi
	fi
}

remove=false
force=false
while [ $# -gt 0 ]; do
	case $1 in
		--remove) remove=true ;;
		--force) force=true ;;
		*) break ;;
	esac
	shift
done

if [ "$force" = true ] && [ "$remove" = false ]; then
	printf 'error: --force requires --remove\n' >&2
	exit 2
fi

branch=${1:-}
if [ -z "$branch" ]; then
	printf 'Branch name: ' >&2
	IFS= read -r branch
fi
[ -n "$branch" ] || exit 0

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
	printf 'error: not in a git repository\n' >&2
	exit 1
}

parent=$(dirname "$repo_root")
worktree_path=$parent/$branch
repo=$(basename "$worktree_path")
[ "$repo" = "$branch" ] && repo=$(basename "$(dirname "$worktree_path")")

if [ "$remove" = true ]; then
	if [ "$force" = false ]; then
		printf 'Remove worktree and artifacts at %s? [y/N] ' "$worktree_path" >&2
		IFS= read -r answer
		case $answer in
			y|Y|yes|YES|Yes) ;;
			*) exit 0 ;;
		esac
	fi

	git-link-artifacts --remove --force "$worktree_path" "$repo" "$branch" || exit 1
	if [ "$force" = true ]; then
		set -- git worktree remove --force "$worktree_path"
	else
		set -- git worktree remove "$worktree_path"
	fi
	if ! result=$("$@" 2>&1); then
		printf 'error: failed to remove worktree: %s\n' "$result" >&2
		exit 1
	fi
	exit 0
fi

preferred_rel=
if [ $# -ge 2 ]; then
	case $2 in
		"$repo_root"/*) preferred_rel=${2#"$repo_root"/} ;;
		*) preferred_rel=$2 ;;
	esac
fi

git fetch origin "$branch" >/dev/null 2>&1 || :
if git rev-parse --verify "origin/$branch" >/dev/null 2>&1; then
	set -- git worktree add "$worktree_path" "$branch"
else
	set -- git worktree add "$worktree_path" -b "$branch"
fi

if ! result=$("$@" 2>&1); then
	printf 'error: failed to create worktree: %s\n' "$result" >&2
	exit 1
fi

git-link-artifacts "$worktree_path" "$repo" "$branch"
get_default_file "$worktree_path" "$preferred_rel"
