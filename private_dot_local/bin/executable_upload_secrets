#!/usr/bin/fish

# 1. Preliminary check
if not test -f .env
    echo (set_color red)"Error: .env file not found."(set_color normal)
    exit 1
end

# 2. Count valid secrets (ignoring comments and empty lines)
set -l secret_count (grep -vE '^\s*(#|$)' .env | wc -l | xargs)
set -l repo_name (gh repo view --json nameWithOwner -q .nameWithOwner)

echo (set_color yellow)"Found $secret_count secrets to upload to: $repo_name"(set_color normal)

# 3. Confirmation Prompt
read -l -P "Proceed with upload? [y/N] " confirm

switch $confirm
    case y Y yes Yes
        echo "Starting upload..."
    case '*'
        echo "Upload cancelled."
        exit 0
end

# 4. Processing Loop
while read -l line
    # Skip lines that are empty or start with a comment (#)
    if string match -qr '^\s*(#|$)' -- "$line"
        continue
    end

    # Split and clean
    set -l parts (string split -m 1 "=" -- "$line")
    set -l key (string trim -- $parts[1])
    set -l value (string trim -- $parts[2])
    set -l clean_value (string trim -c '"\'' -- "$value")

    # Upload
    if gh secret set "$key" --body "$clean_value"
        echo "✅ Uploaded: $key"
    else
        echo "❌ Failed: $key"
    end
end < .env

echo (set_color green)"Finished."(set_color normal)
