#!/bin/bash

TASK="$*"
if [ $# -eq 0 ]; then
  printf 'Task: ' >&2
  read -r TASK
fi

SUMMARY=$(
  pi --no-tools --no-extensions --no-skills --no-context-files --model opencode-go/deepseek-v4-flash:off -p <<EOF
Your task is to describe the goal of the following prompt.
You must use at most 4 words. Only lowercase except for proper names. No punctuation.
Do not describe completion critaira.
Do not describe methodology or intermediate results.
Only describe the goal.

<task>
$TASK
</task>
EOF
)

BRANCH=$(printf '%s' "$SUMMARY" | sed 's/[^A-Za-z0-9._-]/-/g')

## look at branches, both local and remote
## if there is a name collision, add the suffix '-ddd'
## where ddd is the smallest 3 digits without a collision
EXISTING=$(git branch -a 2>/dev/null |
  sed 's/^..//; s|^remotes/[^/]*/||' |
  grep -v ' -> ' |
  sort -u)
if printf '%s\n' "$EXISTING" | grep -qxF -- "$BRANCH"; then
  for n in $(seq 0 999); do
    suffix=$(printf '%03d' "$n")
    candidate="$BRANCH-$suffix"
    if ! printf '%s\n' "$EXISTING" | grep -qxF -- "$candidate"; then
      BRANCH=$candidate
      break
    fi
  done
fi

echo wt switch $BRANCH
echo pi -p "$TASK"

notify-send $BRANCH completed
