#!/bin/sh
dir_name=$(basename "$PWD")
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ -n "$branch" ] && [ "$branch" != "HEAD" ] && [ "$dir_name" = "$branch" ]; then
  repo_name=$(basename "$(dirname "$PWD")")
else
  repo_name=$dir_name
fi
gh repo create "$repo_name" --public --source=.
git push
