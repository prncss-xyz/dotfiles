#!/bin/sh

if [ "$#" -ne 1 ]; then
    printf 'Usage: %s {sleep_monitor|wakeup_monitor}\n' "$0" >&2
    exit 2
fi

case "$1" in
    sleep_monitor|wakeup_monitor)
        ;;
    *)
        printf 'Unsupported monitor power action: %s\n' "$1" >&2
        exit 2
        ;;
esac

mmsg get all-monitors |
    jq -r '.[].name' |
    while IFS= read -r output; do
        [ -n "$output" ] || continue
        mmsg dispatch "$1,$output"
    done
