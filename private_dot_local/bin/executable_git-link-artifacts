#!/bin/sh

remove=false
force=false
while [ $# -gt 0 ]; do
	case $1 in
		--remove) remove=true ;;
		--force) force=true ;;
		*) break ;;
	esac
	shift
done

repo_root=${1:-}
repo=${2:-}
branch=${3:-}

if [ -z "$repo_root" ] || [ -z "$repo" ] || [ -z "$branch" ] || [ $# -ne 3 ]; then
	printf 'usage: git-link-artifacts [--remove [--force]] REPO_ROOT REPO BRANCH\n' >&2
	exit 2
fi

case $repo in
	.|..|*/*)
		printf 'error: invalid repository name: %s\n' "$repo" >&2
		exit 2
		;;
esac

branch_name=$(printf '%s' "$branch" | tr '/' '-')
case $branch_name in
	.|..)
		printf 'error: invalid branch name: %s\n' "$branch" >&2
		exit 2
		;;
esac

projects=${PROJECTS_DIR:-"$HOME/projects"}
artifacts=${ARTIFACTS_DIR:-"$projects/notes/main/dev/artifacts"}
target=$artifacts/$repo
branch_dir=$target/$branch_name
link_path=$repo_root/.artifacts

if [ "$remove" = true ]; then
	notes_root=$(git -C "$branch_dir" rev-parse --show-toplevel 2>/dev/null) || {
		printf 'error: artifacts directory is not in a Git repository: %s\n' "$branch_dir" >&2
		exit 1
	}

	if ! git -C "$notes_root" add -A -- "$branch_dir"; then
		printf 'error: failed to stage artifacts directory: %s\n' "$branch_dir" >&2
		exit 1
	fi
	if ! git -C "$notes_root" commit --allow-empty --allow-empty-message -m ''; then
		printf 'error: failed to commit artifacts directory: %s\n' "$branch_dir" >&2
		exit 1
	fi

	if [ "$force" = false ]; then
		printf 'warning: removing artifacts directory and its contents: %s\n' "$branch_dir" >&2
	fi
	case $branch_dir in
		/*|./*) remove_path=$branch_dir ;;
		*) remove_path=./$branch_dir ;;
	esac
	if ! rm -rf "$remove_path"; then
		printf 'error: failed to remove artifacts directory: %s\n' "$branch_dir" >&2
		exit 1
	fi
	exit 0
fi

if ! mkdir -p "$branch_dir"; then
	printf 'warning: failed to create artifacts directory: %s\n' "$branch_dir" >&2
	exit 0
fi

[ -e "$link_path" ] || [ -L "$link_path" ] && exit 0

link_target=$(awk -v from="$repo_root" -v to="$target" 'BEGIN {
	from_count = split(from, from_parts, "/")
	to_count = split(to, to_parts, "/")
	common = 1
	while (common <= from_count && common <= to_count && from_parts[common] == to_parts[common])
		common++
	result = ""
	for (i = common; i <= from_count; i++)
		if (from_parts[i] != "") result = result (result == "" ? "" : "/") ".."
	for (i = common; i <= to_count; i++)
		if (to_parts[i] != "") result = result (result == "" ? "" : "/") to_parts[i]
	print result == "" ? "." : result
}')

if ! ln -s "$link_target" "$link_path"; then
	printf 'warning: failed to create artifacts link: %s\n' "$link_path" >&2
fi
