#!/bin/sh
set -eu

[ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
  printf '%s\n' 'Usage: merge-from-current <target-branch> [commit-message]' >&2
  exit 1
}
current=$1
git check-ref-format --branch "$current" >/dev/null
source=$(git rev-parse --show-toplevel)
branch=$(git -C "$source" symbolic-ref --short HEAD)

printf 'Merging %s into target branch %s and removing its branch and worktree %s\n' "$branch" "$current" "$source"

message=${2-"Merge $branch"}
[ "$branch" != "$current" ] || {
  printf '%s\n' 'Target branch must differ from the current branch' >&2
  exit 1
}
root=$(git -C "$source" worktree list --porcelain | awk -v ref="refs/heads/$current" '
  /^worktree / { path = substr($0, 10) }
  /^branch / && substr($0, 8) == ref { print path }
')
[ -n "$root" ] || {
  printf 'No worktree found for %s\n' "$current" >&2
  exit 1
}
[ "$(git -C "$root" symbolic-ref --short HEAD)" = "$current" ]
for path in "$root" "$source"; do
  status=$(git -C "$path" status --porcelain)
  [ -z "$status" ] || {
    printf 'Worktree must be clean: %s\n' "$path" >&2
    exit 1
  }
done
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
msgfile=$scratch/message
hooklog=$scratch/hook.log
git_dir=$(git -C "$root" rev-parse --absolute-git-dir)
common_dir=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)
printf '%s\n' "$message" >"$msgfile"
if git -C "$root" hook run --ignore-missing commit-msg -- "$msgfile" >"$hooklog" 2>&1; then
  cat "$hooklog"
else
  cat "$hooklog" >&2
  printf '%s\n' 'Commit message rejected. Calling headless Codex to fix it; this may take a while.' >&2
  codex exec --sandbox workspace-write --cd "$root" --add-dir "$scratch" \
    "The commit-msg hook rejected the proposed merge commit message. Read the hook output in $hooklog and fix the message in $msgfile so it passes the hook. Preserve its intent. Change only that message file; do not edit repository files or hooks, bypass checks, commit, push, or change branches or worktrees. If you cannot fix it, stop and report failure." || exit 1
  git -C "$root" hook run --ignore-missing commit-msg -- "$msgfile" || exit 1
fi
original=$(git -C "$root" rev-parse HEAD)
(
  cd "$root"
  rebase-current "$branch"
)
[ "$(git -C "$root" symbolic-ref --short HEAD)" = "$current" ]
git -C "$root" merge-base --is-ancestor "$branch" HEAD
git -C "$root" reset --soft "$original"
if git -C "$root" diff --cached --quiet; then
  printf '%s\n' 'No changes to merge.'
  exit 0
fi
if git -C "$root" commit -F "$msgfile" >"$hooklog" 2>&1; then
  cat "$hooklog"
else
  cat "$hooklog" >&2
  printf '%s\n' 'Commit failed. Calling headless Codex to fix hook errors; this may take a while.' >&2
  if codex exec --sandbox workspace-write --cd "$root" --add-dir "$git_dir" --add-dir "$common_dir" --add-dir "$scratch" \
    "The merge commit failed. Read the output in $hooklog and fix the reported hook errors. The proposed commit message is in $msgfile; edit it if needed. Make only the changes necessary to pass the hooks, preserve the staged changes, and stage any code fixes. Do not disable or bypass hooks or checks, commit, reset, rebase, push, or change branches or worktrees. The script will retry the commit. If you cannot fix the failure, stop and report failure." &&
    [ "$(git -C "$root" symbolic-ref --short HEAD)" = "$current" ] &&
    [ "$(git -C "$root" rev-parse HEAD)" = "$original" ] &&
    git -C "$root" commit -F "$msgfile"; then
    :
  else
    git -C "$root" reset --hard "$original"
    exit 1
  fi
fi
if remote=$(git -C "$root" config --get "branch.$branch.remote"); then
  remote_ref=$(git -C "$root" config --get "branch.$branch.merge")
elif git -C "$root" remote get-url origin >/dev/null 2>&1; then
  remote=origin
  remote_ref=refs/heads/$branch
else
  remote=
fi
if [ -n "$remote" ] && [ "$remote" != . ]; then
  remote_branch=$(git -C "$root" ls-remote --heads "$remote" "$remote_ref")
  if [ -n "$remote_branch" ]; then
    git -C "$root" push "$remote" ":$remote_ref"
  fi
fi
git -C "$root" worktree remove "$source"
git -C "$root" branch -D -- "$branch"
git -C "$root" rev-parse HEAD
