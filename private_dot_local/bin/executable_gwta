#!/bin/sh

git fetch --all

BRANCH_NAME="$1"
if [ -z "$BRANCH_NAME" ]; then
  printf "Enter branch name: "
  read -r BRANCH_NAME
  if [ -z "$BRANCH_NAME" ]; then
    echo "Error: Branch name cannot be empty."
    exit 1
  fi
fi

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "Error: Not inside a Git repository."
  exit 1
fi

if [ "$(git rev-parse --is-bare-repository 2>/dev/null)" = "true" ]; then
  REPO_ROOT=$(git rev-parse --absolute-git-dir)
else
  REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
fi

if [ -z "$REPO_ROOT" ]; then
  echo "Error: Could not determine repository root."
  exit 1
fi
PARENT_DIR=$(dirname "$REPO_ROOT")

DIR_NAME=$(echo "$BRANCH_NAME" | tr '/' '-')
TARGET_DIR="$PARENT_DIR/$DIR_NAME"

if [ -d "$TARGET_DIR" ]; then
  echo "Error: Directory $TARGET_DIR already exists."
  exit 1
fi

if git worktree add "$TARGET_DIR" "$BRANCH_NAME" >/dev/null 2>&1; then
  echo "Worktree created at $TARGET_DIR for existing branch '$BRANCH_NAME'."
  exit 0
fi

REMOTE=$(git remote | head -n 1)

if [ -n "$REMOTE" ]; then
  if git ls-remote --heads --exit-code "$REMOTE" "$BRANCH_NAME" >/dev/null 2>&1; then
    echo "Branch '$BRANCH_NAME' found on remote '$REMOTE'. Fetching..."
    git fetch "$REMOTE" "$BRANCH_NAME"
    if git worktree add "$TARGET_DIR" "$BRANCH_NAME"; then
       echo "Worktree created at $TARGET_DIR for remote branch '$BRANCH_NAME'."
       exit 0
    else
       echo "Error: Failed to create worktree after fetching."
       exit 1
    fi
  fi
fi

echo "Branch '$BRANCH_NAME' not found locally or remotely. Creating new branch..."
if git worktree add -b "$BRANCH_NAME" "$TARGET_DIR"; then
  if [ -n "$REMOTE" ]; then
    git config branch."$BRANCH_NAME".remote "$REMOTE"
    git config branch."$BRANCH_NAME".merge refs/heads/"$BRANCH_NAME"
    echo "Configured branch '$BRANCH_NAME' to push to '$REMOTE' by default."
  fi
  echo "Worktree created at $TARGET_DIR with new branch '$BRANCH_NAME'."
else
  echo "Failed to create worktree."
  exit 1
fi
