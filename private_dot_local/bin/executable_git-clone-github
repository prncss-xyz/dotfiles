#!/bin/sh

projects=${PROJECTS_DIR:-"$HOME/projects"}
artifacts=${ARTIFACTS_DIR:-"$projects/notes/main/dev/artifacts"}

relative_path() {
	awk -v from="$1" -v to="$2" 'BEGIN {
		from_count = split(from, from_parts, "/")
		to_count = split(to, to_parts, "/")
		common = 1
		while (common <= from_count && common <= to_count && from_parts[common] == to_parts[common])
			common++
		result = ""
		for (index = common; index <= from_count; index++)
			if (from_parts[index] != "") result = result (result == "" ? "" : "/") ".."
		for (index = common; index <= to_count; index++)
			if (to_parts[index] != "") result = result (result == "" ? "" : "/") to_parts[index]
		print result == "" ? "." : result
	}'
}

link_artifacts() {
	repo_root=$1
	repo=$2
	branch=$3
	target=$artifacts/$repo
	branch_dir=$target/$(printf '%s' "$branch" | tr '/' '-')
	link_path=$repo_root/.artifacts

	if ! mkdir -p "$branch_dir"; then
		printf 'warning: failed to create artifacts directory: %s\n' "$branch_dir" >&2
		return
	fi

	[ -e "$link_path" ] || [ -L "$link_path" ] && return
	link_target=$(relative_path "$repo_root" "$target")
	if ! ln -s "$link_target" "$link_path"; then
		printf 'warning: failed to create artifacts link: %s\n' "$link_path" >&2
	fi
}

get_default_file() {
	repo_dir=$1
	preferred_rel=${2:-}

	if [ -n "$preferred_rel" ] && [ -f "$repo_dir/$preferred_rel" ]; then
		printf '%s\n' "$repo_dir/$preferred_rel"
	elif [ -f "$repo_dir/README.md" ]; then
		printf '%s\n' "$repo_dir/README.md"
	else
		first=$(git -C "$repo_dir" ls-files 2>/dev/null | awk 'NR == 1 { print; exit }')
		if [ -n "$first" ]; then
			printf '%s\n' "$repo_dir/$first"
		else
			printf '%s\n' "$repo_dir/README.md"
		fi
	fi
}

input=${1:-}
if [ -z "$input" ]; then
	printf 'Github repo (user/repo or repo): ' >&2
	IFS= read -r input
fi
[ -n "$input" ] || exit 0

repo_dir=$projects/$input
mkdir -p "$repo_dir" || exit 1

branch=$(gh repo view "$input" --json defaultBranchRef -q '.defaultBranchRef.name' 2>/dev/null)
if [ $? -eq 0 ]; then
	clone_dir=$repo_dir/$branch
	if [ ! -d "$clone_dir" ]; then
		if ! gh repo clone "$input" "$clone_dir" >&2; then
			printf 'error: failed to clone %s\n' "$input" >&2
			exit 1
		fi
	fi
	repo_dir=$clone_dir
else
	case $input in
		*/*)
			printf 'error: upstream not found for %s\n' "$input" >&2
			exit 1
			;;
		*)
			if ! (cd "$projects" && gh repo create "$input" --public --clone >&2); then
				printf 'error: failed to create repository %s\n' "$input" >&2
				exit 1
			fi
			;;
	esac
fi

branch=$(git -C "$repo_dir" branch --show-current 2>/dev/null)
[ -n "$branch" ] || branch=main
repo=$(basename "$repo_dir")
[ "$repo" = "$branch" ] && repo=$(basename "$(dirname "$repo_dir")")
link_artifacts "$repo_dir" "$repo" "$branch"
get_default_file "$repo_dir"
