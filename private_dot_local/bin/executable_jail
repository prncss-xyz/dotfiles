#!/usr/bin/env fish

bwrap \
    --ro-bind /usr/bin /usr/bin \
    --ro-bind /usr/lib /usr/lib \
    --ro-bind /lib /lib \
    --proc /proc \
    --dev /dev \
    --unshare-all \
    --die-with-parent \
    --chdir (pwd) \
    --bind (pwd) (pwd) \
    --ro-bind-try $HOME/.local/share/nvim/lazy $HOME/.local/share/nvim/lazy \
    --tmpfs /tmp \
    --tmpfs /run \
    --setenv HOME (pwd) \
    $argv
