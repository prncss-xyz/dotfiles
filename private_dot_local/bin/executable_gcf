#!/bin/sh

# This script reuses the commit message from a previous interrupted commit
# (e.g., when a pre-commit hook fails). It opens the editor with the recovered
# message and automatically strips the git boilerplate comments.

if ! git rev-parse --git-dir >/dev/null 2>&1; then
	echo "Not a git repository" >&2
	exit 1
fi

git_dir=$(git rev-parse --git-dir)
if [ ! -f "$git_dir/COMMIT_EDITMSG" ]; then
	echo "No previous commit message found" >&2
	exit 1
fi

git commit -e -F "$git_dir/COMMIT_EDITMSG" "$@"
