{
  "experimental": {
    "plan": true,
    "enableAgents": true
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "general": {
    "previewFeatures": true
  },
  "mcpServers": {
    "context7": {
      "command": "bun",
      "args": [
        "x",
        "@upstash/context7-mcp"
      ]
    },
    "talivy": {
      "command": "bun",
      "args": [
        "x",
        "tavily-mcp@latest"
      ]
    },
    "exa": {
      "command": "bun",
      "args": [
        "x",
        "exa-mcp-server"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena.git",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--enable-web-dashboard",
        "False"
      ]
    }
  }
}
