{
  "experimental": {
    "plan": true,
    "enableAgents": true
  },
  "tools": {
    "sandbox": "podman"
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "general": {
    "sessionRetention": {
      "enabled": true,
      "maxAge": "30d",
      "warningAcknowledged": true,
      "policyFile": "mcp-read-only.toml"
    }
  },
  "mcpServers": {
    "context7": {
      "command": "bun",
      "args": [
        "x",
        "@upstash/context7-mcp"
      ],
      "trust": true
    },
    "tavily": {
      "command": "bun",
      "args": [
        "x",
        "tavily-mcp@latest"
      ],
      "trust": true
    },
    "exa": {
      "command": "bun",
      "args": [
        "x",
        "exa-mcp-server"
      ],
      "trust": true
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena.git",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--enable-web-dashboard",
        "false"
      ],
      "trust": true
    }
  }
}
