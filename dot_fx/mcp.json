{
  "mcp": {
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git"
      ],
      "type": "local"
    },
    "github": {
      "command": "bun",
      "args": [
        "x",
        "@modelcontextprotocol/server-github"
      ],
      "type": "local"
    },
    "playwright": {
      "command": "bun",
      "args": [
        "x",
        "@playwright/mcp"
      ],
      "type": "local"
    },
    "chrome-devtools": {
      "command": "bun",
      "args": [
        "x",
        "chrome-devtools-mcp@latest"
      ],
      "type": "local"
    },
    "context7": {
      "command": "bun",
      "args": [
        "x",
        "@upstash/context7-mcp"
      ],
      "type": "local"
    },
    "codemod": {
      "command": "bun",
      "args": [
        "x",
        "codemod@latest",
        "mcp"
      ],
      "type": "local"
    },
    "mdn": {
      "url": "https://mcp.mdn.mozilla.net/",
      "type": "http"
    }
  }
}
