cd $HOME/.local/share/chezmoi/
git remote add origin git@github.com:{{ .github_user }}/chezmoi.git || true
gh auth setup-git
dracut_setup

ya pkg install
# pnpm ls -g --depth=0
pnpm i -g @anthropic-ai/sandbox-runtime @earendil-works/pi-coding-agent @typescript/native-preview bash-language-server graphql-language-service-cli portless serve skills vscode-langservers-extracted oxfmt oxlint

# uv tool list
uv tool install yamllint

# sync pi packages declared in readonly_settings.json
# settings.json is chezmoi-readonly, so flip the bit for the install, then restore
if command -v pi >/dev/null && [ -f ~/.pi/agent/settings.json ]; then
    chmod u+w ~/.pi/agent/settings.json
    jq -r '.packages[]' ~/.pi/agent/settings.json | while read -r pkg; do
        pi install "$pkg"
    done
    chmod u-w ~/.pi/agent/settings.json
fi
gh extension install gennaro-tedesco/gh-f
curl -fsSL https://claude.ai/install.sh | bash
# gpg --armor --export-secret-keys {{ .email }} | gpg --symmetric --cipher-algo AES256 -o private_key.asc.gpg
gpg --decrypt private_key.asc.gpg | gpg --import
printf "5\ny\n" | gpg --command-fd 0 --edit-key {{ .email }} trust

# clone nvim

ln -sf $PERSONAL/browser-bookmarks.desktop $HOME/.local/share/applications

{{ if eq .hosted "false" -}}
mkdir -p ~/.config/service/dbus
mkdir -p ~/.local/state/mpd
ln -s /usr/share/examples/turnstile/dbus.run ~/.config/service/dbus/run
ln -s /usr/share/examples/turnstile/dbus.check ~/.config/service/dbus/check
cd
{{ end -}}

