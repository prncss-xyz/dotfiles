{
  "npmCommand": ["pnpm"],
  "tools": {
    "grep": true,
    "find": true,
    "ls": true
  },
  "packages": [
    "npm:pi-web-access",
    "npm:pi-skill-palette",
    "npm:pi-intercom",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-btw",
    "npm:@juicesharp/rpiv-args",
    "npm:pi-sandbox",
    "npm:@observal/pi-insights",
    "npm:pi-hermes-memory",
    "npm:pi-shell-completions",
    "npm:@vanillagreen/pi-codex-minimal-tools",
    "npm:pi-worktrunk",
    "npm:@tmustier/pi-usage-extension",
    "npm:@guwidoe/pi-prompt-suggester",
    "npm:@ryan_nookpi/pi-extension-auto-name"
  ],
  "quietStartup": true,
  "defaultProvider": "opencode-go",
  "defaultModel": "minimax-m3",
  "defaultThinkingLevel": "high",
  "disabledCommands": ["gather-context-and-clarify"],
  "model_fallback": true,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [400, 429, 503, 529],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "timeout_seconds": 30,
    "notify_on_fallback": true
  },
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "tools": "mcp:context7",
        "model": "openai-codex/gpt-5.6-sol",
        "skills": "search"
      },
      "oracle": {
        "model": "opencode-go/deepseek-v4-pro"
      },
      "planner": {
        "model": "opencode-go/glm-5.2"
      },
      "researcher": {
        "tools": "mcp:context7",
        "model": "openai-codex/gpt-5.6-sol",
        "skills": "search"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-sol",
      },
      "scout": {
        "model": "opencode-go/deepseek-v4-flash"
      },
      "worker": {
        "model": "opencode-go/minimax-m3"
      }
    }
  }
}
