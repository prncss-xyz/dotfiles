{
  "npmCommand": ["pnpm"],
  "packages": [
    "npm:pi-web-access",
    "npm:pi-skill-palette",
    "npm:pi-intercom",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-btw",
    "npm:@juicesharp/rpiv-advisor",
    "npm:@juicesharp/rpiv-args",
    "npm:pi-sandbox",
    "npm:@observal/pi-insights",
    "npm:pi-hermes-memory"
  ],
  "quietStartup": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.4-mini",
  "defaultThinkingLevel": "high",
  "lastChangelogVersion": "0.80.2",
  "disabledCommands": ["gather-context-and-clarify"],
  "model_fallback": true,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [400, 429, 503, 529],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "timeout_seconds": 30,
    "notify_on_fallback": true
  },
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "tools": "mcp:context7",
        "model": "openai-codex/gpt-5.5",
        "skills": "search"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.5"
      },
      "planner": {
        "model": "openai-codex/gpt-5.5"
      },
      "researcher": {
        "tools": "mcp:context7",
        "model": "openai-codex/gpt-5.5",
        "skills": "search"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.5"
      },
      "scout": {
        "model": "openai-codex/gpt-5.4-mini"
      },
      "worker": {
        "model": "openai-codex/gpt-5.4-mini"
      }
    }
  }
}
