{
  "mcpServers": {
    "chrome-devtools": {
      "command": "bun",
      "args": ["x", "chrome-devtools-mcp@latest"]
    },
    "context7": {
      "command": "bun",
      "args": ["x", "@upstash/context7-mcp"]
    },
    "tavily": {
      "command": "bun",
      "args": ["x", "tavily-mcp@latest"]
    },
    "exa": {
      "command": "bun",
      "args": ["x", "exa-mcp-server"],
      "enabled": true
    },
    "codemod": {
      "command": "bun",
      "args": ["x", "codemod@latest", "mcp"]
    },
    "duckduckgo": {
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"]
    },
    "vectorcode": {
      "command": "vectorcode-mcp-server"
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena.git",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--enable-web-dashboard",
        "false"
      ]
    }
  }
}
