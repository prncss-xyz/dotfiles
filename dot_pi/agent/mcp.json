{
  "mcpServers": {
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git"],
      "directTools": true
    },
    "github": {
      "command": "bun",
      "args": ["x", "@modelcontextprotocol/server-github"],
      "directTools": true
    },
    "playwright": {
      "command": "bun",
      "args": ["x", "@playwright/mcp"]
    },
    "chrome-devtools": {
      "command": "bun",
      "args": ["x", "chrome-devtools-mcp@latest"]
    },
    "context7": {
      "command": "bun",
      "args": ["x", "@upstash/context7-mcp"]
    },
    "codemod": {
      "command": "bun",
      "args": ["x", "codemod@latest", "mcp"]
    },
    "mdn": {
      "url": "https://mcp.mdn.mozilla.net/"
    },
    "ttsc-graph": {
      "command": "bun",
      "args": ["-x", "@ttsc/graph"]
    }
  }
}
