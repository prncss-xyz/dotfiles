{
  "mcpServers": {
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git"]
    },
    "github": {
      "command": "bun",
      "args": ["x", "@modelcontextprotocol/server-github"]
    },
    "playwright": {
      "command": "bun",
      "args": ["x", "@playwright/mcp"]
    },
    "chrome-devtools": {
      "command": "bun",
      "args": ["x", "chrome-devtools-mcp@latest"]
    },
    "context7": {
      "command": "bun",
      "args": ["x", "@upstash/context7-mcp"]
    },
    "codemod": {
      "command": "bun",
      "args": ["x", "codemod@latest", "mcp"]
    }
  }
}
